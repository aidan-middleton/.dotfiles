#!/usr/bin/env python3
import configparser
import json
import os
import re
import socket
import subprocess
import sys
from collections import defaultdict


class Command:
    args: list[str]

    def __init__(self, args: list[str]):
        self.args = args

    def execute_to_string(self) -> str | None:
        result = None
        try:
            process_result = subprocess.run(self.args, capture_output=True, text=True, check=True)
            result = process_result.stdout.strip()
        except subprocess.CalledProcessError as e:
            print("Command failed:", e, file=sys.stderr)
        return result

    def execute_to_dict(self) -> dict[str, str] | None:
        result = None
        try:
            process_result = subprocess.run(self.args, capture_output=True, text=True, check=True)
            result = json.loads(process_result.stdout)
        except subprocess.CalledProcessError as e:
            print("Command failed:", e, file=sys.stderr)
        except json.JSONDecodeError as e:
            print("Failed to parse JSON:", e, file=sys.stderr)
        return result


HICOLOR_THEME = "hicolor"
DEFAULT_ICON_NAME = "application-default-icon"
DEFAULT_THEME_INDEX = "/usr/share/icons/default/index.theme"

XDG_RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR")
if not XDG_RUNTIME_DIR: raise Exception("XDG_RUNTIME_DIR is not set")

PIXMAP_DIRS = ["/usr/share/pixmaps"]
ICON_EXTENSIONS = ("png", "svg", "xpm")

XDG_DATA_DIRS: list[str] = [
    os.environ.get('XDG_DATA_HOME') or os.path.expanduser("~/.local/share"),
    *(os.environ.get('XDG_DATA_DIRS') or "/usr/local/share/:/usr/share/").split(':')
]

APPLICATION_DIRS: list[str] = [
    f"{directory}/applications"
    for directory in XDG_DATA_DIRS
    if os.path.exists(f"{directory}/applications")
]

ICON_DIRS = [
    directory
    for directory in [
        os.path.expanduser("~/.icons"),
        *[f"{directory}/icons" for directory in XDG_DATA_DIRS],
        "/usr/share/pixmaps",
    ]
    if os.path.exists(directory)
]

RE_DESKTOP_ENTRY_START_WM_CLASS = re.compile(r'^\s*StartupWMClass\s*=\s*(.*?)\s*$', re.MULTILINE)
RE_DESKTOP_ENTRY_ICON = re.compile(r'^\s*Icon\s*=\s*(.*?)\s*$', re.MULTILINE)
RE_THEME_INDEX_INHERITS = re.compile(r'^\s*Inherits\s*=\s*(.*?)\s*$', re.MULTILINE)
RE_HYPR_DELIMITERS = re.compile(r">>|,")

GET_WORKSPACES = Command(["hyprctl", "workspaces", "-j"])
GET_MONITORS = Command(["hyprctl", "monitors", "-j"])
GET_CLIENTS = Command(["hyprctl", "clients", "-j"])
GET_THEME = Command(["gsettings", "get", "org.gnome.desktop.interface", "icon-theme"])

theme_index_cache: dict[str, tuple[list[dict], list[str]] | None] = {}

current_workspace = ""
current_monitor_name = ""
current_monitor_id = 0

special = {}
monitors = {}
workspaces = {}
clients = {}

def subdir_matches_size(subdir: dict, size: int) -> bool:
    sd_type = subdir["type"]
    if sd_type == "Fixed":
        return subdir["size"] == size
    if sd_type == "Scalable":
        return subdir["min_size"] <= size <= subdir["max_size"]
    if sd_type == "Threshold":
        threshold = subdir["threshold"]
        return (subdir["size"] - threshold) <= size <= (subdir["size"] + threshold)
    return False


def subdir_size_distance(subdir: dict, size: int) -> int:
    sd_type = subdir["type"]
    if sd_type == "Fixed":
        return abs(subdir["size"] - size)
    if sd_type == "Scalable":
        if size < subdir["min_size"]:
            return subdir["min_size"] - size
        if size > subdir["max_size"]:
            return size - subdir["max_size"]
        return 0
    if sd_type == "Threshold":
        threshold = subdir["threshold"]
        if size < subdir["size"] - threshold:
            return (subdir["size"] - threshold) - size
        if size > subdir["size"] + threshold:
            return size - (subdir["size"] + threshold)
        return 0
    return 2 ** 31




def read_theme_index(theme_name: str) -> tuple[list[dict], list[str]] | None:
    if theme_name in theme_index_cache:
        return theme_index_cache[theme_name]

    result: tuple[list[dict], list[str]] | None = None
    for base in ICON_DIRS:
        index_path = os.path.join(base, theme_name, "index.theme")
        if not os.path.isfile(index_path):
            continue
        parser = configparser.ConfigParser(strict=False)
        try:
            parser.read(index_path, encoding="utf-8")
        except (OSError, configparser.Error):
            continue
        if "Icon Theme" not in parser:
            continue
        icon_theme_section = parser["Icon Theme"]
        dir_names = [
            d.strip()
            for d in icon_theme_section.get("Directories", "").split(",")
            if d.strip()
        ]
        subdirs = []
        for name in dir_names:
            if name not in parser:
                continue
            section = parser[name]
            size = section.getint("Size", fallback=0)
            subdirs.append({
                "name": name,
                "type": section.get("Type", fallback="Threshold"),
                "size": size,
                "min_size": section.getint("MinSize", fallback=size),
                "max_size": section.getint("MaxSize", fallback=size),
                "threshold": section.getint("Threshold", fallback=2),
            })
        inherits = [
            i.strip()
            for i in icon_theme_section.get("Inherits", "").split(",")
            if i.strip()
        ]
        result = (subdirs, inherits)
        break

    theme_index_cache[theme_name] = result
    return result


def lookup_icon_file(icon_name: str, size: int, theme_name: str, visited: set[str]) -> str | None:
    if theme_name in visited:
        return None
    visited.add(theme_name)

    index = read_theme_index(theme_name)
    if index is not None:
        subdirs, inherits = index

        for base in ICON_DIRS:
            for subdir in subdirs:
                if not subdir_matches_size(subdir, size):
                    continue
                for ext in ICON_EXTENSIONS:
                    candidate = os.path.join(base, theme_name, subdir["name"], f"{icon_name}.{ext}")
                    if os.path.isfile(candidate):
                        return candidate
        closest_path: str | None = None
        closest_distance = 2 ** 31
        for base in ICON_DIRS:
            for subdir in subdirs:
                for ext in ICON_EXTENSIONS:
                    candidate = os.path.join(base, theme_name, subdir["name"], f"{icon_name}.{ext}")
                    if not os.path.isfile(candidate):
                        continue
                    distance = subdir_size_distance(subdir, size)
                    if distance < closest_distance:
                        closest_distance = distance
                        closest_path = candidate
        if closest_path is not None:
            return closest_path

        for parent in inherits:
            found = lookup_icon_file(icon_name, size, parent, visited)
            if found is not None:
                return found

    return None


def lookup_fallback_icon(icon_name: str) -> str | None:
    for base in [*ICON_DIRS, *PIXMAP_DIRS]:
        for ext in ICON_EXTENSIONS:
            candidate = os.path.join(base, f"{icon_name}.{ext}")
            if os.path.isfile(candidate):
                return candidate
    return None


def find_icon(icon_name: str, size: int, theme_name: str) -> str | None:
    found = lookup_icon_file(icon_name, size, theme_name, set())
    if found is not None:
        return found
    if theme_name != HICOLOR_THEME:
        found = lookup_icon_file(icon_name, size, HICOLOR_THEME, set())
        if found is not None:
            return found
    return lookup_fallback_icon(icon_name)


def iter_desktop_files():
    seen_ids = set()
    for directory in APPLICATION_DIRS:
        if not os.path.isdir(directory):
            continue
        for root, _dirs, files in os.walk(directory):
            rel_root = os.path.relpath(root, directory)
            for name in files:
                if not name.endswith(".desktop"):
                    continue
                if rel_root == ".":
                    desktop_file_id = name
                else:
                    rel_path = os.path.join(rel_root, name)
                    desktop_file_id = rel_path.replace(os.sep, "-")
                if desktop_file_id in seen_ids:
                    continue
                seen_ids.add(desktop_file_id)
                yield desktop_file_id, os.path.join(root, name)


def peak(path: str, pattern: re.Pattern[str]) -> str | None:
    with open(path, "r", encoding="utf-8") as f:
        content = f.read()
        match = pattern.search(content)
        if match:
            return match.group(1)
    return None


def get_icon(client_class: str, size: int = 16) -> str:
    entries = list(iter_desktop_files())
    target_desktop_file_id = f"{client_class}.desktop"
    icon_name = None

    for desktop_file_id, path in entries:
        if desktop_file_id == target_desktop_file_id:
            icon_name = peak(path, RE_DESKTOP_ENTRY_ICON)
            break
    if icon_name is None:
        for desktop_file_id, path in entries:
            start_wm_class = peak(path, RE_DESKTOP_ENTRY_START_WM_CLASS)
            if start_wm_class == client_class:
                icon_name = peak(path, RE_DESKTOP_ENTRY_ICON)
                break
    if icon_name is None:
        icon_name = DEFAULT_ICON_NAME

    if icon_name.startswith("/"):
        return icon_name if os.path.isfile(icon_name) else ""

    icon_theme = (GET_THEME.execute_to_string() or "").replace("'", "").strip()
    if not icon_theme:
        if os.path.isfile(DEFAULT_THEME_INDEX):
            icon_theme = peak(DEFAULT_THEME_INDEX, RE_THEME_INDEX_INHERITS) or ""
    if not icon_theme:
        icon_theme = HICOLOR_THEME

    icon_path = find_icon(icon_name, size, icon_theme)
    if icon_path is None and icon_name != DEFAULT_ICON_NAME:
        icon_path = find_icon(DEFAULT_ICON_NAME, size, icon_theme)

    return icon_path or ""


def print_workspaces():
    sorted_workspaces = [workspaces[k] for k in sorted(workspaces)]
    print(json.dumps(sorted_workspaces), flush=True)


def set_current_workspace(workspace_id: int):
    global current_workspace
    current_workspace = workspace_id
    if workspace_id in workspaces:
        workspaces[workspace_id]["isUrgent"] = False
        workspaces[workspace_id]["isBell"] = False


for workspace in (GET_WORKSPACES.execute_to_dict() or defaultdict(dict)):
    id = workspace["id"]
    workspaces[id] = {}
    workspaces[id]["id"] = workspace["id"]
    workspaces[id]["name"] = workspace["name"]
    workspaces[id]["monitor"] = workspace["monitor"]
    workspaces[id]["monitorID"] = workspace["monitorID"]
    workspaces[id]["isActive"] = False
    workspaces[id]["isUrgent"] = False
    workspaces[id]["isBell"] = False
    workspaces[id]["clients"] = []

for client in (GET_CLIENTS.execute_to_dict() or defaultdict(dict)):
    id = client["workspace"]["id"]
    address = client["address"].removeprefix("0x")
    client_class = client["class"]
    icon = get_icon(client_class)
    workspaces[id]["clients"].append(icon)
    clients[address] = {"workspace": id, "icon": icon}

for monitor in (GET_MONITORS.execute_to_dict() or defaultdict(dict)):
    monitors[monitor["name"]] = int(monitor["id"])
    if monitor["focused"] == True:
        current_monitor_name = monitor["name"]
        current_monitor_id = monitor["id"]
        current_workspace = int(monitor["activeWorkspace"]["id"])
    if monitor["specialWorkspace"]["id"] != 0:
        special_id = int(monitor["specialWorkspace"]["id"])
        special[int(monitor["id"])] = special_id
        workspaces[special_id]["isActive"] = True
    active_id = int(monitor["activeWorkspace"]["id"])
    workspaces[active_id]["isActive"] = True
print_workspaces()

sock_path = os.path.join(XDG_RUNTIME_DIR, "hypr", os.environ.get('HYPRLAND_INSTANCE_SIGNATURE', ''), ".socket2.sock")
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
    client.connect(sock_path)
    with client.makefile('r', buffering=1) as sock_file:
        for line in sock_file:
            line = line.strip()
            arguments = RE_HYPR_DELIMITERS.split(line)
            match arguments[0]:
                case "focusedmonv2":
                    current_monitor_name = arguments[1]
                    current_monitor_id = int(monitors[arguments[1]])
                    set_current_workspace(int(arguments[2]))
                    print_workspaces()
                case "destroyworkspacev2":
                    destroyed_id = int(arguments[1])
                    workspaces.pop(destroyed_id)
                    for address in [a for a, c in clients.items() if c["workspace"] == destroyed_id]:
                        del clients[address]
                    print_workspaces()
                case "workspacev2":
                    old_workspace = int(current_workspace)
                    set_current_workspace(int(arguments[1]))
                    if workspaces.get(old_workspace) != None:
                        workspaces[old_workspace]['isActive'] = False
                    workspaces[current_workspace]['isActive'] = True
                    print_workspaces()
                case "createworkspacev2":
                    id = int(arguments[1])
                    workspaces[id] = {}
                    workspaces[id]["id"] = id
                    workspaces[id]["name"] = arguments[2]
                    workspaces[id]["monitor"] = current_monitor_name
                    workspaces[id]["monitorID"] = current_monitor_id
                    workspaces[id]["isActive"] = False
                    workspaces[id]["isUrgent"] = False
                    workspaces[id]["isBell"] = False
                    workspaces[id]["clients"] = []
                    print_workspaces()
                case "activespecialv2":
                    monitor = arguments[3]
                    monitor_id = monitors[monitor]
                    if arguments[1] != '':
                        id = int(arguments[1])
                        workspaces[id]["id"] = id
                        workspaces[id]["name"] = arguments[2]
                        workspaces[id]["monitor"] = monitor
                        workspaces[id]["monitorID"] = monitor_id
                        workspaces[id]["isActive"] = True
                        workspaces[id]["isUrgent"] = False
                        workspaces[id]["isBell"] = False
                        workspaces[id]["clients"] = []
                        special[monitor_id] = id
                    else:
                        id = int(special[monitor_id])
                        workspaces[id]["isActive"] = False
                    print_workspaces()
                case "openwindow":
                    address = arguments[1]
                    id = int(arguments[2])
                    client_class = arguments[3]
                    icon = get_icon(client_class)
                    workspaces[id]["clients"].append(icon)
                    clients[address] = {"workspace": id, "icon": icon}
                    print_workspaces()
                case "closewindow":
                    address = arguments[1]
                    if address in clients:
                        client = clients[address]
                        id = client["workspace"]
                        icon = client["icon"]
                        workspaces[id]["clients"].remove(icon)
                        del clients[address]
                        print_workspaces()
                case "movewindow":
                    address = arguments[1]
                    if address in clients:
                        id = int(arguments[2])
                        client = clients[address]
                        icon = client["icon"]
                        old_id = client["workspace"]
                        if old_id in workspaces:
                            workspaces[old_id]["clients"].remove(icon)
                        clients[address]["workspace"] = id
                        workspaces[id]["clients"].append(icon)
                        print_workspaces()
                case "urgent":
                    address = arguments[1]
                    client = clients.get(address)
                    if client is not None and client["workspace"] in workspaces:
                        workspace_id = client["workspace"]
                        if workspace_id != current_workspace:
                            workspaces[workspace_id]["isUrgent"] = True
                            print_workspaces()
                case "bell":
                    address = arguments[1] if len(arguments) > 1 else ""
                    client = clients.get(address)
                    if client is not None and client["workspace"] in workspaces:
                        workspace_id = client["workspace"]
                        if workspace_id != current_workspace:
                            workspaces[workspace_id]["isBell"] = True
                            print_workspaces()
